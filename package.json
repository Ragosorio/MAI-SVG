{
  "name": "mai-svg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local raster-to-vector experiments and SVG validation",
  "scripts": {
    "mai": "tsx packages/cli/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build --config apps/editor/vite.config.ts",
    "start": "tsx packages/cli/main.ts serve --editor"
  },
  "dependencies": {
    "@visioncortex/vtracer": "1.0.0-alpha.4",
    "@xmldom/xmldom": "0.9.12",
    "css-tree": "3.1.0",
    "paper": "0.12.18",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "svgo": "4.1.0",
    "svgpath": "2.6.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/css-tree": "2.3.10",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
